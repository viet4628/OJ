SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Engine mode (khuyến nghị): judge qua rsjudge Rust.
# Bỏ trống/hủy comment để dùng sandbox local (bwrap + time + timeout).
RSJUDGE_ENDPOINT=127.0.0.1:50051

# Port worker phục vụ testcase cho engine (engine trỏ --cases-endpoint về đây)
RSJUDGE_PROVIDER_BIND=127.0.0.1:50052

# Worker liveness (Docker publishes only on host loopback)
WORKER_POLL_INTERVAL_MS=2000
WORKER_HEALTH_BIND=127.0.0.1
WORKER_HEALTH_PORT=9090
WORKER_ID=primary
WORKER_REQUEST_TIMEOUT_MS=8000
