 // SPDX-License-Identifier: Apache-2.0
 
+//! Implementation of the judge gRPC services.
+//!
+//! The `Submit` flow follows the standard SASTOJ architecture:
+//!
+//! 1. Backend sends `Submit(language, code, problem_id, cases_id)`.
+//! 2. Engine compiles the source, streaming a `CompileInfo` event back.
+//! 3. Engine pulls the case archive from the backend's `CasesService`
+//!    (`FetchCases(problem_id)` with a `cases_id` metadata entry): a
+//!    zstd-compressed tarball containing `config.json` (a [`CasesConfig`])
+//!    plus the referenced input/answer files.
+//! 4. Each case runs under the configured resource limits; results stream
+//!    back as `CaseInfo`, followed by a final `CasesSummary`.
+
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::time::Duration;
+
 use log::debug;
+use rsjudge_judger::comparer::{CompareResult, Comparer as _};
+use rsjudge_judger::judger::pipeline;
+use rsjudge_judger::judger::request::cases::{CasesConfig, TaskType};
+use rsjudge_traits::judger::JudgeResult;
+use rsjudge_traits::language::config::LanguageDef;
+use rsjudge_traits::language::option::{ConfigValue, LanguageOption};
+use tokio::sync::mpsc;
 use tokio_stream::wrappers::ReceiverStream;
 use tonic::{Request, Response, Status, async_trait};
 
+use crate::proto::cases_service_client::CasesServiceClient;
 use crate::proto::judge_service_server::JudgeService;
-use crate::proto::{SelfTestRequest, SelfTestResponse, SubmitRequest, SubmitResponse};
+use crate::proto::{
+    CaseInfo, CasesSummary, CompileInfo as ProtoCompileInfo, FetchCasesRequest,
+    JudgeResult as ProtoJudgeResult, SelfTestRequest, SelfTestResponse, SelfTestSummary,
+    SubmitRequest, SubmitResponse,
+};
+
+const CASES_ID_METADATA_KEY: &str = "cases_id";
+const SELF_TEST_TIME_LIMIT: Duration = Duration::from_secs(5);
+const SELF_TEST_MEMORY_BYTES: u64 = 512 * 1024 * 1024;
+const STREAM_BUFFER: usize = 16;
+
+/// Shared configuration of the judge server.
+#[derive(Clone)]
+pub struct JudgeServerImpl {
+    executors: Arc<HashMap<String, LanguageDef>>,
+    cases_endpoint: Option<Arc<str>>,
+}
+
+impl JudgeServerImpl {
+    /// Create the judge service implementation.
+    #[must_use]
+    pub fn new(
+        executors: Arc<HashMap<String, LanguageDef>>,
+        cases_endpoint: Option<Arc<str>>,
+    ) -> Self {
+        Self {
+            executors,
+            cases_endpoint,
+        }
+    }
+}
+
+fn proto_result(result: &JudgeResult) -> ProtoJudgeResult {
+    match result {
+        JudgeResult::Accepted => ProtoJudgeResult::Accepted,
+        JudgeResult::CompileError => ProtoJudgeResult::CompileError,
+        JudgeResult::WrongAnswer => ProtoJudgeResult::WrongAnswer,
+        JudgeResult::PresentationError => ProtoJudgeResult::PresentationError,
+        JudgeResult::RuntimeError => ProtoJudgeResult::RuntimeError,
+        JudgeResult::TimeLimitExceeded => ProtoJudgeResult::TimeLimitExceeded,
+        JudgeResult::MemoryLimitExceeded => ProtoJudgeResult::MemoryLimitExceeded,
+        JudgeResult::OutputLimitExceeded => ProtoJudgeResult::OutputLimitExceeded,
+    }
+}
+
+fn language_option_from(
+    name: &str,
+    configs: &HashMap<String, crate::proto::ConfigType>,
+) -> LanguageOption {
+    let config = configs
+        .iter()
+        .filter_map(|(key, value)| {
+            let parsed = match &value.config_type {
+                Some(crate::proto::config_type::ConfigType::Boolean(_)) => ConfigValue::Bool(true),
+                Some(crate::proto::config_type::ConfigType::Enum(value)) => {
+                    ConfigValue::Enum(value.clone())
+                }
+                None => return None,
+            };
+            Some((key.clone(), parsed))
+        })
+        .collect();
+    LanguageOption {
+        name: name.to_owned(),
+        config,
+    }
+}
+
+struct FetchedCases {
+    dir: tempfile::TempDir,
+    config: CasesConfig,
+}
+
+/// Download and unpack the case archive for `(problem_id, cases_id)`.
+async fn fetch_cases(
+    endpoint: &str,
+    problem_id: i32,
+    cases_id: i32,
+) -> Result<FetchedCases, Status> {
+    let mut client = CasesServiceClient::connect(endpoint.to_owned())
+        .await
+        .map_err(|e| Status::unavailable(format!("cannot reach cases service: {e}")))?;
+
+    let mut request = Request::new(FetchCasesRequest { problem_id });
+    request
+        .metadata_mut()
+        .insert(
+            CASES_ID_METADATA_KEY,
+            tonic::metadata::AsciiMetadataValue::try_from(cases_id.to_string())
+                .map_err(|_| Status::internal("cannot encode cases_id metadata"))?,
+        );
+
+    let mut stream = client
+        .fetch_cases(request)
+        .await
+        .map_err(|e| Status::unavailable(format!("fetch_cases failed: {e}")))?
+        .into_inner();
+
+    let mut blob: Vec<u8> = Vec::new();
+    while let Some(chunk) = stream
+        .message()
+        .await
+        .map_err(|e| Status::unavailable(format!("cases stream failed: {e}")))?
+    {
+        if blob.len().saturating_add(chunk.chunk.len()) > pipeline::OUTPUT_LIMIT_BYTES {
+            return Err(Status::resource_exhausted("case archive too large"));
+        }
+        blob.extend_from_slice(&chunk.chunk);
+    }
+
+    unpack_archive(&blob).await
+}
+
+/// Unpack a zstd-compressed (or plain) tar archive, parse `config.json`,
+/// and return the extracted cases directory + parsed config.
+pub(crate) async fn unpack_archive(blob: &[u8]) -> Result<FetchedCases, Status> {
+    let is_zstd = blob.starts_with(&[0x28, 0xB5, 0x2F, 0xFD]);
+    let decoded: std::borrow::Cow<'_, [u8]> = if is_zstd {
+        zstd::stream::decode_all(blob)
+            .map_err(|e| Status::invalid_argument(format!("case archive is not valid zstd: {e}")))?
+            .into()
+    } else {
+        std::borrow::Cow::Borrowed(blob)
+    };
+
+    let dir = tempfile::tempdir()
+        .map_err(|e| Status::internal(format!("cannot create cases dir: {e}")))?;
+    {
+        let mut archive = tar::Archive::new(&decoded[..]);
+        for entry in archive.entries().map_err(|e| Status::invalid_argument(format!("cannot read tar entries: {e}")))? {
+            let mut entry = entry.map_err(|e| Status::invalid_argument(format!("bad tar entry: {e}")))?;
+            // Prevent Zip Slip: reject entries with absolute paths or '..'
+            let path = entry.path().map_err(|_| Status::invalid_argument("invalid tar entry path"))?;
+            if path.is_absolute() || path.components().any(|c| c == std::path::Component::ParentDir) {
+                return Err(Status::invalid_argument("tar entry with unsafe path rejected"));
+            }
+            entry.unpack_in(dir.path()).map_err(|e| Status::invalid_argument(format!("cannot unpack tar entry: {e}")))?;
+        }
+    }
+
+    let raw = tokio::fs::read(dir.path().join("config.json"))
+        .await
+        .map_err(|_| Status::invalid_argument("case archive misses config.json"))?;
+    let config: CasesConfig = serde_json::from_slice(&raw)
+        .map_err(|e| Status::invalid_argument(format!("invalid config.json: {e}")))?;
+
+    Ok(FetchedCases { dir, config })
+}
+
+pub(crate) struct PreparedCase {
+    id: i32,
+    input_path: PathBuf,
+    answer_path: PathBuf,
+    score: u32,
+}
+
+/// Group cases into scoring units: one group for `simple`, one per subtask.
+/// The second element is the group's bonus score (0 for simple tasks, where
+/// individual case scores apply directly).
+fn flatten_groups(config: &CasesConfig) -> Vec<(Vec<PreparedCase>, u32)> {
+    fn even_split(total: u32, n: usize) -> Vec<u32> {
+        if n == 0 {
+            return Vec::new();
+        }
+        let base = total / n as u32;
+        let rem = total % n as u32;
+        (0..n)
+            .map(|i| base + u32::from(i < rem as usize))
+            .collect()
+    }
+
+    match &config.task {
+        TaskType::Simple { cases } => {
+            let scores = even_split(config.score.get(), cases.len());
+            vec![(
+                cases
+                    .iter()
+                    .zip(scores)
+                    .enumerate()
+                    .map(|(i, (case, default_score))| PreparedCase {
+                        id: i as i32 + 1,
+                        input_path: case.input.clone(),
+                        answer_path: case.answer.clone(),
+                        score: case.score.map_or(default_score, std::num::NonZeroU32::get),
+                    })
+                    .collect(),
+                0,
+            )]
+        }
+        TaskType::Subtask { subtasks } => {
+            let scores = even_split(config.score.get(), subtasks.len());
+            subtasks
+                .iter()
+                .zip(scores)
+                .enumerate()
+                .map(|(si, (subtask, default_score))| {
+                    (
+                        subtask
+                            .cases
+                            .iter()
+                            .enumerate()
+                            .map(|(ci, case)| PreparedCase {
+                                id: (si * 100 + ci + 1) as i32,
+                                input_path: case.input.clone(),
+                                answer_path: case.answer.clone(),
+                                score: case.score.map_or(0, std::num::NonZeroU32::get),
+                            })
+                            .collect(),
+                        subtask
+                            .score
+                            .map_or(default_score, std::num::NonZeroU32::get),
+                    )
+                })
+                .collect()
+        }
+    }
+}
+
+/// Run one case and compare its output against the expected answer.
+#[allow(clippy::too_many_arguments)]
+async fn run_and_compare(
+    prepared_source: &pipeline::PreparedSource,
+    def: &LanguageDef,
+    case: &PreparedCase,
+    cases_root: &Path,
+    time_limit: Duration,
+    memory_bytes: Option<u64>,
+    comparer: &rsjudge_judger::comparer::DefaultComparer,
+) -> Result<CaseInfo, Status> {
+    let input = tokio::fs::read(cases_root.join(&case.input_path))
+        .await
+        .map_err(|e| Status::invalid_argument(format!("cannot read case input: {e}")))?;
+
+    let outcome = pipeline::run_once(prepared_source, def, &input, time_limit, memory_bytes)
+        .await
+        .map_err(|e| Status::internal(format!("run failed: {e}")))?;
+
+    let mut verdict = pipeline::verdict_of(&outcome, memory_bytes);
+    if verdict == JudgeResult::Accepted {
+        let answer = tokio::fs::File::open(cases_root.join(&case.answer_path))
+            .await
+            .map_err(|e| Status::invalid_argument(format!("cannot read answer file: {e}")))?;
+        verdict = match comparer.compare(&outcome.stdout[..], answer).await {
+            Ok(CompareResult::Accepted) => JudgeResult::Accepted,
+            Ok(CompareResult::PresentationError) => JudgeResult::PresentationError,
+            Ok(CompareResult::WrongAnswer) | Err(_) => JudgeResult::WrongAnswer,
+        };
+    }
+
+    let passed = verdict == JudgeResult::Accepted;
+    Ok(CaseInfo {
+        case_id: case.id,
