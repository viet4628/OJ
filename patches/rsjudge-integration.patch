+#[cfg(feature = "grpc")]
+async fn register_backend(
+    endpoint: &str,
+    languages: indexmap::IndexMap<String, rsjudge_traits::language::info::LanguageInfo>,
+) -> anyhow::Result<i32> {
+    use crate::proto_shim::register_service_client::RegisterServiceClient;
+    use crate::proto_shim::{ConfigTypeDecl, EnumDecl, LanguageDecl, RegisterRequest};
+    use tonic::Request;
+
+    let mut client = RegisterServiceClient::connect(endpoint.to_owned()).await?;
+
+    let decls = languages
+        .into_iter()
+        .map(|(_name, info)| LanguageDecl {
+            name: info.name,
+            configs: info
+                .config
+                .into_iter()
+                .map(|(key, cfg)| {
+                    (
+                        key,
+                        ConfigTypeDecl {
+                            config_type: Some(match cfg {
+                                rsjudge_traits::language::info::ConfigInfo::Bool => {
+                                    crate::proto_shim::config_type_decl::ConfigType::Boolean(())
+                                }
+                                rsjudge_traits::language::info::ConfigInfo::Enum(variants) => {
+                                    crate::proto_shim::config_type_decl::ConfigType::Enum(
+                                        EnumDecl {
+                                            variants: variants.into_iter().collect(),
+                                        },
+                                    )
+                                }
+                            }),
+                            description: String::new(),
+                        },
+                    )
+                })
+                .collect(),
+        })
+        .collect();
+
+    let response = client
+        .register(Request::new(RegisterRequest {
+            languages: decls,
+            port: 0,
+            system_info: String::new(),
+        }))
+        .await?
+        .into_inner();
+    Ok(response.id)
+}
