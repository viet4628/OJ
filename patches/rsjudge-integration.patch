+
+fn option_overrides(
+    def: &LanguageDef,
+    raw: &HashMap<String, serde_json::Value>,
+) -> rsjudge_traits::language::option::LanguageOption {
+    use rsjudge_traits::language::option::ConfigValue;
+    let config = def
+        .options()
+        .keys()
+        .filter_map(|key| {
+            let value = raw.get(key)?;
+            let parsed = match value {
+                serde_json::Value::Bool(b) => ConfigValue::Bool(*b),
+                serde_json::Value::String(s) => ConfigValue::Enum(s.clone()),
+                _ => return None,
+            };
+            Some((key.clone(), parsed))
+        })
+        .collect();
+    rsjudge_traits::language::option::LanguageOption {
+        name: String::new(),
+        config,
+    }
+}
+
+async fn languages(State(state): State<SharedExecutors>) -> axum::Json<serde_json::Value> {
+
+    let langs: Vec<serde_json::Value> = state
+        .iter()
+        .map(|(name, def)| {
+            let configs = def
+                .options()
+                .iter()
+                .map(|(key, val)| match val {
+                    ConfigDef::Bool { default, .. } => serde_json::json!({
+                        "name": key,
+                        "type": "bool",
+                        "default": default,
+                    }),
+                    ConfigDef::Enum { default, variants, .. } => serde_json::json!({
+                        "name": key,
+                        "type": "enum",
+                        "default": default,
+                        "variants": variants.keys().collect::<Vec<_>>(),
+                    }),
+                })
+                .collect::<Vec<_>>();
+            serde_json::json!({ "name": name, "configs": configs })
+        })
+        .collect();
+    axum::Json(serde_json::json!({ "languages": langs }))
+}
+
+async fn selftest(
+    State(state): State<SharedExecutors>,
+    axum::Json(body): axum::Json<SelfTestBody>,
+) -> Result<axum::Json<SelfTestResult>, (axum::http::StatusCode, String)> {
+    let Some(def) = state.get(&body.language) else {
+        return Err((
+            axum::http::StatusCode::BAD_REQUEST,
+            format!("unsupported language: {}", body.language),
+        ));
+    };
+
+    let opts = option_overrides(def, &body.options);
+    let prepared = pipeline::prepare_source(&body.language, def, body.code.as_bytes(), Some(&opts))
+        .await
+        .map_err(|e| (axum::http::StatusCode::INTERNAL_SERVER_ERROR, e.to_string()))?;
+    let compile_info = pipeline::compile(&prepared, def)
+        .await
+        .map_err(|e| (axum::http::StatusCode::INTERNAL_SERVER_ERROR, e.to_string()))?;
+
+    if !compile_info.success() {
+        return Ok(axum::Json(SelfTestResult {
+            compile_exit_status: compile_info.exit_status,
+            compile_stderr: compile_info.stderr,
+            executed: false,
+            exit_status: None,
+            stdout: None,
+            stderr: None,
+            execution_time_ms: None,
+            memory_usage_kib: None,
+            verdict: None,
+        }));
+    }
+
+    let time_limit =
+        Duration::from_millis(body.time_limit_ms.unwrap_or(SELF_TEST_TIME_LIMIT_MS));
+    let mem_bytes = u64::from(body.memory_limit_mb.unwrap_or(SELF_TEST_MEMORY_MB)) * 1024 * 1024;
+
+    let outcome = pipeline::run_once(&prepared, def, body.stdin.as_bytes(), time_limit, Some(mem_bytes))
+        .await
+        .map_err(|e| (axum::http::StatusCode::INTERNAL_SERVER_ERROR, e.to_string()))?;
+    let verdict = pipeline::verdict_of(&outcome, Some(mem_bytes));
+    let verdict_name = match verdict {
+        rsjudge_traits::judger::JudgeResult::Accepted => "ACCEPTED",
+        rsjudge_traits::judger::JudgeResult::TimeLimitExceeded => "TIME_LIMIT_EXCEEDED",
+        rsjudge_traits::judger::JudgeResult::MemoryLimitExceeded => "MEMORY_LIMIT_EXCEEDED",
+        rsjudge_traits::judger::JudgeResult::OutputLimitExceeded => "OUTPUT_LIMIT_EXCEEDED",
+        _ => "RUNTIME_ERROR",
+    };
+    let timed_out = verdict == rsjudge_traits::judger::JudgeResult::TimeLimitExceeded;
+
+    Ok(axum::Json(SelfTestResult {
+        compile_exit_status: compile_info.exit_status,
+        compile_stderr: compile_info.stderr,
+        executed: true,
+        exit_status: Some(outcome.exit_code),
+        stdout: Some(pipeline::lossy(&outcome.stdout)),
+        stderr: Some(pipeline::lossy(&outcome.stderr)),
+        execution_time_ms: (!timed_out)
+            .then(|| u32::try_from(outcome.cpu_time.as_millis()).unwrap_or(u32::MAX)),
+        memory_usage_kib: (!timed_out).then_some(outcome.ram_kb as u32),
+        verdict: Some(verdict_name),
+    }))
+}
