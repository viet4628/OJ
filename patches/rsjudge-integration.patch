@@ -0,0 +1,821 @@
+// SPDX-License-Identifier: Apache-2.0
+
+//! The judging pipeline: prepare source, compile, run with resource limits,
+//! and classify results. Built on top of [`rsjudge_runner`].
+
+use std::collections::HashMap;
+use std::fmt;
+use std::num::NonZeroU64;
+use std::path::{Path, PathBuf};
+use std::process::{ExitStatus, Stdio};
+use std::time::{Duration, Instant};
+
+use indexmap::{IndexMap, IndexSet};
+use rsjudge_runner::utils::resources::rusage::WaitForResourceUsage as _;
+use rsjudge_runner::utils::resources::{ChildWithDeadline, WithResourceLimit as _};
+use rsjudge_runner::Error as RunnerError;
+use rsjudge_traits::judger::JudgeResult;
+use rsjudge_traits::language::config::{ConfigDef, ExecType, LanguageDef};
+use rsjudge_traits::language::info::{ConfigInfo, LanguageInfo};
+use rsjudge_traits::language::option::{ConfigValue, LanguageOption};
+use rsjudge_traits::resource::ResourceLimit;
+use tempfile::TempDir;
+use tokio::fs;
+use tokio::io::{AsyncReadExt as _, AsyncWriteExt as _};
+
+/// Hard cap of captured program output per stream.
+pub const OUTPUT_LIMIT_BYTES: usize = 1024 * 1024;
+
+const COMPILE_WALL_SECS: u64 = 120;
+const COMPILE_MEM_BYTES: u64 = 2 * 1024 * 1024 * 1024;
+const COMPILE_FSIZE_BYTES: u64 = 256 * 1024 * 1024;
+/// Extra wall time past the CPU limit (same margin as the worker's local sandbox).
+const WALL_GRACE: Duration = Duration::from_millis(1500);
+
+/// Error of the judging pipeline.
+#[derive(Debug)]
+pub struct PipelineError(pub String);
+
+impl fmt::Display for PipelineError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(&self.0)
+    }
+}
+
+impl std::error::Error for PipelineError {}
+
+/// Result type of the judging pipeline.
+pub type Result<T, E = PipelineError> = std::result::Result<T, E>;
+
+/// A source prepared inside its own working directory.
+#[derive(Debug)]
+pub struct PreparedSource {
+    /// Working directory holding all files of this submission.
+    /// Kept alive until dropped; deleting it cleans everything up.
+    pub workdir: TempDir,
+    /// Absolute path of the source file on disk.
+    pub src_path: PathBuf,
+    /// Absolute path of the compiled artifact (`binary`/`byte_code`).
+    pub out_path: PathBuf,
+    /// Command template rendered into an absolute argv for execution.
+    /// `None` for `binary` languages (the artifact is executed directly).
+    pub execute_argv: Option<Vec<String>>,
+}
+
+/// Outcome of one program execution.
+#[derive(Debug, Clone)]
+pub struct RunOutcome {
+    /// Process exit code (`-1` when killed by a signal).
+    pub exit_code: i32,
+    /// Terminating signal number, if any.
+    pub signal: Option<i32>,
+    /// Captured stdout (truncated at [`OUTPUT_LIMIT_BYTES`]).
+    pub stdout: Vec<u8>,
+    /// Captured stderr (truncated at [`OUTPUT_LIMIT_BYTES`]).
+    pub stderr: Vec<u8>,
+    /// CPU time reported by `wait4(2)`.
+    pub cpu_time: Duration,
+    /// Peak resident set size in KiB.
+    pub ram_kb: u64,
+    /// Killed because the wall/CPU time limit was reached.
+    pub timed_out: bool,
+    /// Output streams were cut off by the capture cap.
+    pub output_truncated: bool,
+    /// Wall-clock time the process was allowed to live.
+    pub elapsed: Duration,
+}
+
+/// Classify an outcome against the configured limits into a
+/// [`JudgeResult`] (comparison is done separately by the caller).
+///
+/// `memory_bytes` is the effective address-space/RSS budget in bytes, or
+/// `None` when the language opted out of address-space limiting.
+#[must_use]
+pub fn verdict_of(outcome: &RunOutcome, memory_bytes: Option<u64>) -> JudgeResult {
+    if outcome.timed_out {
+        return JudgeResult::TimeLimitExceeded;
+    }
+    if let Some(mem) = memory_bytes {
+        if outcome.ram_kb.saturating_mul(1024) > mem {
+            return JudgeResult::MemoryLimitExceeded;
+        }
+    }
+    if outcome.output_truncated {
+        return JudgeResult::OutputLimitExceeded;
+    }
+    if outcome.signal.is_some() || outcome.exit_code != 0 {
+        let stderr = lossy(&outcome.stderr);
+        if stderr.contains("MemoryError") || stderr.contains("std::bad_alloc") || stderr.contains("memory allocation of") {
+            return JudgeResult::MemoryLimitExceeded;
+        }
+        return JudgeResult::RuntimeError;
+    }
+    JudgeResult::Accepted
+}
+
+/// Build the list of supported-language descriptors for registration/UI.
+#[must_use]
+pub fn accept_languages(
+    executors: &HashMap<String, LanguageDef>,
+) -> IndexMap<String, LanguageInfo> {
+    executors
+        .iter()
+        .map(|(name, def)| {
+            let config = def
+                .options()
+                .iter()
+                .map(|(key, val)| {
+                    (
+                        key.clone(),
+                        match val {
+                            ConfigDef::Bool { .. } => ConfigInfo::Bool,
+                            ConfigDef::Enum { variants, .. } => {
+                                ConfigInfo::Enum(variants.keys().cloned().collect())
+                            }
+                        },
+                    )
+                })
+                .collect();
+            (
+                name.clone(),
+                LanguageInfo {
+                    name: name.clone(),
+                    config,
+                },
+            )
+        })
+        .collect()
+}
+
+fn lang_extension(name: &str) -> &'static str {
+    match name {
+        "C" => "c",
+        "C++" => "cc",
+        "Rust" => "rs",
+        "Java" => "java",
+        "C#" => "cs",
+        "Go" => "go",
+        "Dart" => "dart",
+        "Kotlin" => "kt",
+        "Swift" => "swift",
+        "Zig" => "zig",
+        "JavaScript" => "js",
+        "TypeScript" => "ts",
+        "Python" => "py",
+        "Ruby" => "rb",
+        _ => "txt",
+    }
+}
+
+/// Resolve the `{...flags}` value from language defaults overridden by the
+/// submission's chosen options.
+#[must_use]
+pub fn resolve_flags(def: &LanguageDef, opts: Option<&LanguageOption>) -> String {
+    let mut flags: IndexSet<String> = IndexSet::new();
+    for (key, val) in def.options() {
+        let chosen = opts.and_then(|o| o.config.get(key));
+        match (val, chosen) {
+            (ConfigDef::Bool { default, enable, .. }, None) if *default => {
+                flags.insert((*enable).to_owned());
+            }
+            (ConfigDef::Bool { enable, .. }, Some(ConfigValue::Bool(true))) => {
+                flags.insert((*enable).to_owned());
+            }
+            (ConfigDef::Enum { default, variants, .. }, None) => {
+                if let Some(v) = variants.get(default.as_str()) {
+                    flags.insert(v.clone());
+                }
+            }
+            (ConfigDef::Enum { variants, .. }, Some(ConfigValue::Enum(v))) => match variants.get(v)
+            {
+                Some(val) => {
+                    flags.insert(val.clone());
+                }
+                None => log::warn!("unknown variant '{v}' for option '{key}' ignored"),
+            },
+            _ => {}
+        }
+    }
+    flags.into_iter().collect::<Vec<_>>().join(" ")
+}
+
+/// Render a command template: `{...flags}` plus `{src_file}`, `{out_file}`,
+/// `{tmp_dir}` placeholders.
+#[must_use]
+pub fn render_template(
+    template: &str,
+    flags: &str,
+    src_file: &Path,
+    out_file: &Path,
+    tmp_dir: &Path,
+) -> String {
+    template
+        .replace("{...flags}", flags)
+        .replace("{src_file}", &src_file.to_string_lossy())
+        .replace("{out_file}", &out_file.to_string_lossy())
+        .replace("{tmp_dir}", &tmp_dir.to_string_lossy())
+}
+
+fn clean_env(cmd: &mut tokio::process::Command) -> &mut tokio::process::Command {
+    cmd.env_clear()
+        .env("PATH", "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")
+        .env("HOME", "/tmp")
+        .env("TMPDIR", "/tmp")
+        .env("LANG", "C.UTF-8")
+        .env("PYTHONDONTWRITEBYTECODE", "1")
+}
+
+// Only the submission directory is writable; testcase archives and service
+// credentials are never mounted. Missing/blocked bwrap fails closed.
+fn sandbox_command(workdir: &Path) -> tokio::process::Command {
+    let mut cmd = tokio::process::Command::new("/usr/bin/bwrap");
+    cmd.args(["--unshare-all", "--die-with-parent", "--new-session", "--cap-drop", "ALL",
+        "--ro-bind", "/usr", "/usr", "--dev", "/dev", "--proc", "/proc",
+        "--tmpfs", "/tmp", "--bind"])
+        .arg(workdir).arg(workdir).arg("--chdir").arg(workdir);
+    for path in ["/bin", "/lib", "/lib64", "/etc/alternatives", "/etc/ld.so.cache"] {
+        cmd.args(["--ro-bind-try", path, path]);
+    }
+    cmd.arg("--clearenv");
+    for (key, value) in [("PATH", "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"),
+        ("HOME", "/tmp"), ("TMPDIR", "/tmp"), ("LANG", "C.UTF-8"), ("LC_ALL", "C"),
+        ("PYTHONDONTWRITEBYTECODE", "1")] {
+        cmd.args(["--setenv", key, value]);
+    }
+    cmd.kill_on_drop(true);
+    cmd
+}
+
+fn is_time_limit_exceeded(err: &RunnerError) -> bool {
+    #[cfg(debug_assertions)]
+    {
+        matches!(err, RunnerError::TimeLimitExceeded(..))
+    }
+    #[cfg(not(debug_assertions))]
+    {
+        matches!(err, RunnerError::TimeLimitExceeded())
+    }
+}
+
+/// Read a pipe to completion, keeping at most `cap` bytes and flagging
+/// truncation.
+async fn drain_capped<R: tokio::io::AsyncRead + Unpin>(
+    mut reader: R,
+    cap: usize,
+) -> (Vec<u8>, bool) {
+    let mut buf = Vec::new();
+    let mut truncated = false;
+    let mut chunk = [0u8; 16 * 1024];
+    loop {
+        match reader.read(&mut chunk).await {
+            Ok(0) => break,
+            Ok(n) => {
+                let remaining = cap.saturating_sub(buf.len());
+                if remaining == 0 {
+                    truncated = true;
+                    // Continue draining to unblock the child, discard data.
+                    continue;
+                }
+                let take = n.min(remaining);
+                buf.extend_from_slice(&chunk[..take]);
+                if take < n {
+                    truncated = true;
+                }
+            }
+            Err(_) => break,
+        }
+    }
+    (buf, truncated)
+}
+
+async fn wait_with_captures(
+    mut child: ChildWithDeadline,
+    started_at: Instant,
+) -> std::result::Result<RunOutcome, RunnerError> {
+    let stdout_pipe = child.child_mut().stdout.take();
+    let stderr_pipe = child.child_mut().stderr.take();
+
+    let out_task = tokio::spawn(async move {
+        match stdout_pipe {
+            Some(pipe) => drain_capped(pipe, OUTPUT_LIMIT_BYTES).await,
+            None => (Vec::new(), false),
+        }
+    });
+    let err_task = tokio::spawn(async move {
+        match stderr_pipe {
+            Some(pipe) => drain_capped(pipe, OUTPUT_LIMIT_BYTES).await,
+            None => (Vec::new(), false),
+        }
+    });
+
+    let waited = child.wait_for_resource_usage().await;
+    let elapsed = started_at.elapsed();
+
+    let (out_res, err_res) = tokio::join!(out_task, err_task);
+    let (stdout, out_trunc) = out_res.unwrap_or((Vec::new(), false));
+    let (stderr, err_trunc) = err_res.unwrap_or((Vec::new(), false));
+
+    // On TLE the child never got reaped normally: fall back to wall time and
+    // an unknown RSS.
+    let (status, usage, timed_out) = match waited {
+        Ok((status, usage)) => (Some(status), Some(usage), false),
+        Err(err) if is_time_limit_exceeded(&err) => (None, None, true),
+        Err(err) => return Err(err),
+    };
+
+    let (exit_code, signal) = match &status {
+        Some(status) => (
+            status.code().unwrap_or(-1),
+            signal_of(status),
+        ),
+        None => (-1, Some(9)),
+    };
+    let cpu_time = usage.map_or(elapsed, |u| u.cpu_time());
+    let ram_kb = usage.map_or(0, |u| u.ram_usage());
+
+    Ok(RunOutcome {
+        exit_code,
+        signal,
+        stdout,
+        stderr,
+        cpu_time,
+        ram_kb,
+        timed_out,
+        output_truncated: out_trunc || err_trunc,
+        elapsed,
+    })
+}
+
+fn signal_of(status: &ExitStatus) -> Option<i32> {
+    use std::os::unix::process::ExitStatusExt as _;
+    status.signal()
+}
+
+/// Prepare the working directory and source file of one submission.
+///
+/// # Errors
+///
+/// Fails when the working directory cannot be created/written, the language
+/// has no usable command configuration, or templates render to nothing.
+pub async fn prepare_source(
+    lang_name: &str,
+    def: &LanguageDef,
+    code: &[u8],
+    opts: Option<&LanguageOption>,
+) -> Result<PreparedSource> {
+    let workdir = tempfile::Builder::new()
+        .prefix("rsjudge-job-")
+        .tempdir()
+        .map_err(|e| PipelineError(format!("cannot create work dir: {e}")))?;
+    let tmp = workdir.path().to_path_buf();
+
+    let src_name = def
+        .src_rename()
+        .map_or_else(|| format!("main.{}", lang_extension(lang_name)), str::to_owned);
+    let ext_suffix = def.out_extension().map_or_else(String::new, |e| format!(".{e}"));
+    let out_name = format!("main{ext_suffix}");
+
+    let src_path = tmp.join(&src_name);
+    let out_path = tmp.join(&out_name);
+
+    fs::write(&src_path, code)
+        .await
+        .map_err(|e| PipelineError(format!("cannot write source: {e}")))?;
+
+    let flags = resolve_flags(def, opts);
+    let vars = |tpl: &str| render_template(tpl, &flags, &src_path, &out_path, &tmp);
+
+    let execute_argv = match def.exec_type() {
+        ExecType::Binary { .. } => None,
+        ExecType::ByteCode { execute, .. } => Some(split_command(&vars(execute))?),
+        ExecType::SourceCode { execute, .. } => Some(split_command(&vars(execute))?),
+    };
+
+    Ok(PreparedSource {
+        workdir,
+        src_path,
+        out_path,
+        execute_argv,
+    })
+}
+
+fn split_command(rendered: &str) -> Result<Vec<String>> {
+    shlex::split(rendered)
+        .filter(|argv| !argv.is_empty())
+        .ok_or_else(|| PipelineError(format!("cannot parse execute command: {rendered:?}")))
+}
+
+/// Compile (or syntax-check) the prepared source.
+///
+/// Runs the language's `compile`/`check` command via `/bin/sh -c` under
+/// fixed sandboxing limits. Interpreted languages without a `check` command
+/// succeed trivially.
+///
+/// # Errors
+///
+/// Fails on IO problems; compilation errors are reported in the returned
+/// info instead.
+pub async fn compile(prepared: &PreparedSource, def: &LanguageDef) -> Result<CompileInfo> {
+    let cmd_tpl = match def.exec_type() {
+        ExecType::Binary { compile } | ExecType::ByteCode { compile, .. } => Some(compile),
+        ExecType::SourceCode { check, .. } => check.as_ref(),
+    };
+    let Some(cmd_tpl) = cmd_tpl else {
+        return Ok(CompileInfo::default());
+    };
+
+    let rendered = render_template(cmd_tpl, &resolve_flags(def, None), &prepared.src_path, &prepared.out_path, prepared.workdir.path());
+
+    let mut cmd = sandbox_command(prepared.workdir.path());
+    cmd.arg("/bin/sh").arg("-c").arg(&rendered).current_dir(prepared.workdir.path());
+    cmd.stdin(Stdio::null()).stdout(Stdio::piped()).stderr(Stdio::piped());
+    clean_env(&mut cmd);
+
+    let limit = ResourceLimit::new(
+        Some(Duration::from_secs(COMPILE_WALL_SECS)),
+        Some(Duration::from_secs(COMPILE_WALL_SECS)),
+        NonZeroU64::new(COMPILE_MEM_BYTES),
+        NonZeroU64::new(COMPILE_FSIZE_BYTES),
+    );
+
+    let started_at = Instant::now();
+    let child = cmd
+        .spawn_with_resource_limit(limit)
+        .map_err(|e| PipelineError(format!("cannot spawn compiler: {e}")))?;
+    let outcome = wait_with_captures(child, started_at)
+        .await
+        .map_err(|e| PipelineError(format!("{e}")))?;
+
+    Ok(CompileInfo {
+        exit_status: outcome.exit_code,
+        stdout: lossy(&outcome.stdout),
+        stderr: lossy(&outcome.stderr),
+    })
+}
+
+/// Lossy-convert bytes to a UTF-8 string.
+#[must_use]
+pub fn lossy(bytes: &[u8]) -> String {
+    String::from_utf8_lossy(bytes).into_owned()
+}
+
+/// Information about a compilation/check step.
+#[derive(Debug, Default, Clone)]
+pub struct CompileInfo {
+    /// Exit status of the compiler; `0` indicates success.
+    pub exit_status: i32,
+    /// Captured compiler stdout.
+    pub stdout: String,
+    /// Captured compiler stderr.
+    pub stderr: String,
+}
+
+impl CompileInfo {
+    /// Whether the compilation succeeded.
+    #[must_use]
+    pub fn success(&self) -> bool {
+        self.exit_status == 0
+    }
+}
+
+/// Execute the prepared program once with the given input and limits.
+///
+/// # Errors
+///
+/// Fails when spawning/waiting breaks outside of user-code behaviour.
+pub async fn run_once(
+    prepared: &PreparedSource,
+    def: &LanguageDef,
+    input: &[u8],
+    time_limit: Duration,
+    memory_bytes: Option<u64>,
+) -> Result<RunOutcome> {
+    let user_argv: Vec<String> = match &prepared.execute_argv {
+        Some(argv) => argv.clone(),
+        None => vec![prepared.out_path.to_string_lossy().into_owned()],
+    };
+    // `wait4` on the sandbox only reports the sandbox's own usage: the user
+    // program lives in a PID namespace, so its CPU time and peak RSS are lost.
+    // GNU time inside the sandbox measures the program itself.
+    let report = prepared.workdir.path().join(USAGE_REPORT);
+    let argv = usage_argv(&report, &user_argv);
+
+    let mut cmd = sandbox_command(prepared.workdir.path());
+    cmd.args(&argv).current_dir(prepared.workdir.path());
+    cmd.stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped());
+    clean_env(&mut cmd);
+
+    let fsize = NonZeroU64::new(OUTPUT_LIMIT_BYTES as u64);
+    // `RLIMIT_CPU` has second granularity: round up so a fractional limit
+    // (e.g. 1500ms) never kills a program inside its budget. The exact limit
+    // is enforced below from the measured CPU time.
+    let cpu_secs = u64::try_from(time_limit.as_millis().div_ceil(1000)).unwrap_or(u64::MAX).max(1);
+    let (cpu, mem) = if def.disable_rlimit_as() {
+        (Some(Duration::from_secs(cpu_secs)), None)
+    } else {
+        (
+            Some(Duration::from_secs(cpu_secs)),
+            memory_bytes.and_then(NonZeroU64::new),
+        )
+    };
+    // The wall deadline only stops blocked/sleeping programs; CPU time decides
+    // TLE, so contention from parallel jobs cannot turn a fast program into TLE.
+    let limit = ResourceLimit::new(cpu, Some(time_limit + WALL_GRACE), mem, fsize);
+
+    let started_at = Instant::now();
+    let mut child = cmd
+        .spawn_with_resource_limit(limit)
+        .map_err(|e| PipelineError(format!("cannot spawn program: {e}")))?;
+
+    // Feed stdin; ignore EPIPE when the program exits early.
+    let input = input.to_vec();
+    let stdin_task = child.child_mut().stdin.take().map(|mut stdin| tokio::spawn(async move {
+        let _ = stdin.write_all(&input).await;
+    }));
+
+    let mut outcome = wait_with_captures(child, started_at)
+        .await
+        .map_err(|e| PipelineError(format!("{e}")))?;
+    // A killed program may not leave a report behind; keep the sandbox usage then.
+    if let Some((cpu_time, ram_kb)) = parse_usage_report(&report).await {
+        outcome.cpu_time = cpu_time;
+        outcome.ram_kb = ram_kb;
+    }
+    outcome.timed_out |= outcome.cpu_time >= time_limit;
+    if let Some(task) = stdin_task { task.abort(); }
+    Ok(outcome)
+}
+
+/// Report file written by the usage wrapper inside the sandbox.
+const USAGE_REPORT: &str = ".usage-report";
+/// GNU time, present in the judge image and reachable through the read-only `/usr` bind.
+const TIME_BIN: &str = "/usr/bin/time";
+
+/// Wrap the user command so it reports its own CPU time and peak RSS.
+fn usage_argv(report: &Path, user_argv: &[String]) -> Vec<String> {
+    let mut argv = vec![
+        TIME_BIN.to_owned(),
+        "-f".to_owned(),
+        "%U %S %M".to_owned(),
+        "-o".to_owned(),
+        report.to_string_lossy().into_owned(),
+    ];
+    argv.extend(user_argv.iter().cloned());
+    argv
+}
+
+/// Parse the wrapper report into (CPU time, peak RSS in KiB).
+async fn parse_usage_report(report: &Path) -> Option<(Duration, u64)> {
+    let text = tokio::fs::read_to_string(report).await.ok()?;
+    let line = text
+        .lines()
+        .map(str::trim)
+        .find(|line| line.split_whitespace().count() == 3)?;
+    let mut parts = line.split_whitespace();
+    let user: f64 = parts.next()?.parse().ok()?;
+    let system: f64 = parts.next()?.parse().ok()?;
+    let max_rss: u64 = parts.next()?.parse().ok()?;
+    Some((Duration::from_secs_f64(user + system), max_rss))
+}
