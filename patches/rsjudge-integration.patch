+/// Pick the more severe verdict (TLE > MLE > OLE > RTE > WA > PE).
+/// This ensures the final overall status reflects the most meaningful failure.
+fn worse_of(a: JudgeResult, b: JudgeResult) -> JudgeResult {
+    fn severity(r: JudgeResult) -> u8 {
+        match r {
+            JudgeResult::TimeLimitExceeded => 6,
+            JudgeResult::MemoryLimitExceeded => 5,
+            JudgeResult::OutputLimitExceeded => 4,
+            JudgeResult::RuntimeError => 3,
+            JudgeResult::WrongAnswer => 2,
+            JudgeResult::PresentationError => 1,
+            _ => 0,
+        }
+    }
+    if severity(a) >= severity(b) { a } else { b }
+}
