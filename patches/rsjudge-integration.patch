+#[async_trait]
+impl CasesService for MockCases {
+    type FetchCasesStream = ReceiverStream<Result<FetchCasesResponse, Status>>;
+
+    async fn fetch_cases(
+        &self,
+        request: Request<FetchCasesRequest>,
+    ) -> Result<Response<Self::FetchCasesStream>, Status> {
+        let problem_id = request.into_inner().problem_id;
+        let archive = self
+            .archives
+            .get(&problem_id)
+            .cloned()
+            .ok_or_else(|| Status::not_found("unknown problem"))?;
+
+        let (tx, rx) = mpsc::channel(4);
+        tokio::spawn(async move {
+            for chunk in archive.chunks(64 * 1024) {
+                if tx
+                    .send(Ok(FetchCasesResponse {
+                        chunk: Bytes::copy_from_slice(chunk),
+                    }))
+                    .await
+                    .is_err()
+                {
+                    break;
+                }
+            }
+        });
+        Ok(Response::new(ReceiverStream::new(rx)))
+    }
+}
