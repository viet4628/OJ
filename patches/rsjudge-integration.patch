+    let cases_addr = spawn_mock(HashMap::new()).await;
+    let judge_addr = spawn_judge(format!("http://{cases_addr}")).await;
+
+    let mut client = JudgeServiceClient::connect(format!("http://{judge_addr}"))
+        .await
+        .unwrap();
+
+    let mut stream = client
+        .self_test(Request::new(SelfTestRequest {
+            language: Some(Language {
+                name: "C++".into(),
+                configs: Default::default(),
+            }),
+            code: AB_SOURCE.into(),
+            stdin: "20 22\n".into(),
+        }))
+        .await
+        .unwrap()
+        .into_inner();
+
+    let mut summary = None;
+    while let Some(event) = stream.message().await.unwrap() {
+        if let Some(rsjudge_grpc::proto::self_test_response::SelfTestResponseType::Summary(s)) =
+            event.self_test_response_type
+        {
+            summary = Some(s);
+        }
+    }
+    let summary = summary.expect("no summary received");
+    assert_eq!(summary.exit_status, 0);
+    assert_eq!(summary.stdout.trim_end(), "42");
+}
